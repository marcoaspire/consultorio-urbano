# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de Datos PostgreSQL Estándar
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consultorio_urbano

# Autenticación JWT Nativa
JWT_SECRET=super_secret_jwt_key_consultorio_urbano_2026_production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Almacenamiento Cloudflare R2 (S3 Compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=consultorio-urbano-assets
# URL pública o dominio personalizado configurado para el bucket de Cloudflare R2
R2_PUBLIC_URL=https://pub-yourbucket.r2.dev
